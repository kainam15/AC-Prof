Screen {
    layout: vertical;
    background: $background;
}

* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $accent 65%;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $surface;
}

VerticalScroll, TextArea, DataTable, #command-preview { scrollbar-size: 1 1; }

/* Keep the title bar one row tall, including Textual's click-expanded state. */
Header, Header.-tall { height: 1; background: $surface; color: $text; }
HeaderIcon, HeaderClockSpace { display: none; }
#quit-app {
    dock: right;
    width: 5;
    min-width: 5;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
    background: $surface;
    color: $text-muted;
    content-align: center middle;
}
#quit-app:hover, #quit-app:focus {
    background: $error;
    color: $background;
    text-style: bold;
}
#environment-status {
    display: none;
    dock: right;
    width: auto;
    min-width: 16;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
}
#environment-status:hover, #environment-status:focus { text-style: bold underline; }
#preflight-run-reason {
    display: none;
    height: auto;
    max-height: 2;
    color: $warning;
    overflow-y: auto;
}
TabbedContent { height: 1fr; }
#experiment-pages { height: 1fr; }
TabPane { padding: 0; }
Tabs { background: $surface; }
Tab { padding: 0 2; }
/* Keep application settings at the viewport edge when labels or terminal size change. */
#main-tabs #tabs-list-bar, #main-tabs #tabs-list { width: 1fr; }
#main-tabs #--content-tab-settings-tab { dock: right; }
Tab.-active { color: $accent; text-style: bold; }
Tabs:focus Tab.-active { color: $background; background: $accent; }
Underline { color: $accent; }

.page-header { height: auto; padding: 0 2; margin-bottom: 1; }
.page-title { height: 1; color: $foreground; text-style: bold; }
.page-summary { height: auto; max-height: 2; color: $text-muted; overflow-y: auto; }
#image-heading { height: auto; width: 1fr; }
#image-storage { width: auto; min-width: 14; margin-left: 1; }
.pane-scroll { padding: 0 2; height: 1fr; }
.section-title {
    text-style: bold;
    color: $text;
    height: 1;
    margin: 1 0;
}
.page-hint { color: $text-muted; height: auto; margin-bottom: 1; }
.form-grid {
    grid-size: 4;
    grid-columns: 16 1fr 18 1fr;
    grid-gutter: 0 1;
    height: auto;
}
.form-grid Label {
    height: 3;
    content-align: left middle;
    color: $text-muted;
}
.form-grid.tool-form-grid { grid-size: 2; grid-columns: 18 1fr; }
Input, Select { width: 1fr; }
.number-field { height: 3; }
.number-field Input { width: 16; }
.form-grid .number-field .field-unit { width: auto; margin-left: 1; }
/* Basic line glyphs avoid seams in terminals that misrender tall block borders. */
Input, SelectCurrent, SelectOverlay {
    background: transparent;
    background-tint: transparent;
    border: solid $panel;
}
Input {
    padding: 0 1;
}
Input:focus { border: solid $accent; }
Select:focus > SelectCurrent, Select.-expanded > SelectCurrent, SelectOverlay:focus {
    border: solid $accent;
}

#config-summary { color: $text-muted; }
#command-details { height: auto; margin-bottom: 1; border: none; background: $surface; padding: 0; }
#command-preview { height: auto; max-height: 8; overflow-y: auto; padding: 0 1; }
#science-note { height: auto; color: $text-muted; margin-top: 1; }

.action-bar {
    dock: bottom;
    height: 4;
    padding: 0 2;
    border-top: solid $panel;
    background: $surface;
}
.action-secondary {
    width: 1fr;
    height: 3;
    align-horizontal: left;
}
.action-primary {
    width: auto;
    height: 3;
    margin-left: 1;
    align-horizontal: right;
}
/* Transparent fill keeps the terminal cells outside rounded corners clear. */
Button, .action-bar Checkbox {
    min-width: 14;
    height: 3;
    padding: 0 1;
    background: transparent;
    background-tint: transparent;
    tint: transparent;
    border: round $foreground 60%;
    color: $foreground;
    text-style: none;
}
Button.-primary { text-style: bold; }
Button:hover, Button:focus, .action-bar Checkbox:hover, .action-bar Checkbox:focus {
    border: round $foreground;
    color: $foreground;
    text-style: bold underline;
}
Button.-primary, Button.-primary:focus, Button.-primary:hover {
    border: round $primary;
    color: $primary;
}
Button.-success, Button.-success:focus, Button.-success:hover {
    border: round $success;
    color: $success;
}
Button.-warning, Button.-warning:focus, Button.-warning:hover {
    border: round $warning;
    color: $warning;
}
Button.-error, Button.-error:focus, Button.-error:hover {
    border: round $error;
    color: $error;
}
Button.-active { text-style: bold underline; }
Button:disabled, Button:disabled:hover, Button:disabled:focus, Button:disabled.-active,
.action-bar Checkbox:disabled, .action-bar Checkbox:disabled:hover, .action-bar Checkbox:disabled:focus {
    border: round $ui-disabled;
    color: $ui-disabled;
    text-style: none;
    opacity: 65%;
}
.action-bar Button { margin-left: 1; }
.action-bar Button:first-child { margin-left: 0; }
.button-row { height: auto; margin: 1 0; }
.button-row Button { margin-right: 1; }

.checkbox-row { height: auto; margin: 1 0; }
.option-checkbox { margin-right: 1; background: transparent; border: tall transparent; }
.option-checkbox > .toggle--button { color: $text-muted; background: $panel; }
.option-checkbox.-on > .toggle--button { color: $background; background: $accent; }
.option-checkbox:focus { border: tall $accent; }
.option-checkbox:disabled { color: $ui-disabled; }
.option-checkbox:disabled > .toggle--button { color: $ui-disabled; background: $panel; }
.action-bar Checkbox > .toggle--label {
    color: $foreground;
    background: transparent;
    text-style: none;
}
.action-bar Checkbox:hover > .toggle--label, .action-bar Checkbox:focus > .toggle--label {
    text-style: bold underline;
}
.action-bar Checkbox:disabled > .toggle--label {
    color: $ui-disabled;
    text-style: none;
}
Input:disabled { color: $ui-disabled; border: solid $ui-disabled; }
Select:disabled > SelectCurrent { color: $ui-disabled; border: solid $ui-disabled; }
#profile-tools {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 3;
    height: 6;
}
#profile-tools .option-checkbox { width: 1fr; margin-right: 0; }
#profile-tools .option-checkbox > .toggle--button,
#permissions-tab .option-checkbox > .toggle--button { color: $panel; }
#profile-tools .option-checkbox.-on > .toggle--button,
#permissions-tab .option-checkbox.-on > .toggle--button { color: $background; }
#profile-tools .option-checkbox:disabled > .toggle--button,
#permissions-tab .option-checkbox:disabled > .toggle--button { color: $ui-disabled; background: $panel; }
.settings-section {
    height: auto;
    border: solid $panel;
    border-title-color: $foreground;
    border-title-style: bold;
    padding: 0 1;
    margin-bottom: 1;
}
.settings-section .form-grid { grid-size: 2; grid-columns: 18 1fr; max-width: 76; }
#settings-status.stage-running { color: $accent; }
#settings-status.stage-success { color: $success; }
#settings-status.stage-error { color: $error; }
#saved-run-summary { height: auto; border-left: thick $accent; padding: 0 1; margin-bottom: 1; }

#status-grid {
    grid-size: 4;
    grid-columns: 12 1fr 12 1fr;
    grid-gutter: 0 1;
    height: auto;
    padding: 0 2;
    margin: 0;
    background: transparent;
}
#status-grid .status-label { color: $text-muted; }
#status-detail { height: 1; text-overflow: ellipsis; }
#status-preparation { height: auto; padding: 0 1; }
#log-panel { width: 100%; height: 1fr; min-height: 5; padding: 0; }
#log-toolbar { height: 4; background: transparent; }
#log-toolbar Button {
    min-width: 12;
    padding: 0;
}
#restore-log { display: none; }
#log-panel.-maximized { padding: 0; }
#log-panel.-maximized #expand-log { display: none; }
#log-panel.-maximized #restore-log { display: block; }
#run-log {
    height: 1fr;
    min-height: 3;
    border: round $panel;
    padding: 0 1;
    margin: 0 2;
    background: transparent;
    background-tint: transparent;
}
#run-log:focus { border: round $accent; }
#run-log .text-area--selection { background: $accent; color: $background; }
#run-log {
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-corner-color: $background;
}

#result-summary {
    height: auto;
    background: transparent;
    border: none;
    border-top: solid $panel;
    padding: 1 0;
    margin-top: 1;
}
#report-panel { padding: 0 2; height: 1fr; }
Rule.content-divider { height: 1; margin: 0; color: $panel; }
#report-table {
    height: 1fr;
    min-height: 3;
    background: transparent;
    border: none;
}
#report-detail { height: auto; max-height: 4; margin-top: 1; color: $text-muted; overflow-y: auto; }

#image-panel { padding: 0 2; height: 1fr; }
#image-filters { height: 3; }
#image-scope { width: 24; margin-right: 1; }
#image-scope > SelectCurrent { padding: 0 1; }
#image-scope > SelectCurrent, #image-search {
    background: transparent;
    background-tint: transparent;
}
#image-actions Button { min-width: 7; width: auto; padding: 0 1; }
.image-view-button { min-width: 9; width: auto; padding: 0 1; margin-left: 1; }
#image-search { width: 1fr; min-width: 10; }
#image-workspace { height: 1fr; min-height: 7; overflow: hidden; }
#image-browser { height: 1fr; min-height: 3; }
#image-tree-view, #image-table, #image-layer-table { height: 1fr; }
#image-tree { height: 1fr; overflow-y: scroll; scrollbar-size: 1 1; }
#image-tree > .image-tree--path { color: $block-cursor-background; text-style: bold; }
#image-tree-header { height: 1; color: $text-muted; background: $panel; padding-right: 1; scrollbar-size: 0 0; }
#image-detail-resize { height: 1; color: $text-muted; }
#image-detail-resize:hover, #image-detail-resize:focus, #image-detail-resize.-dragging {
    color: $accent;
    background: $panel;
    text-style: bold;
}
#image-detail-scroll { height: 9; min-height: 3; }
#image-detail-scroll Static { height: auto; }
#image-detail-title { color: $accent; text-style: bold; }
#image-detail { color: $text; margin-bottom: 1; }
#image-detail-scroll Collapsible { border: none; padding: 0; background: $surface; }
#image-detail-scroll CollapsibleTitle { padding: 0; }
#image-detail-scroll Collapsible > Contents { padding: 1 1 1 3; }
#image-diagnostics { color: $text-muted; }
AcprofTui.narrow #image-actions Button { min-width: 7; padding: 0; }
.stage-idle { color: $text-muted; }
.stage-running { color: $accent; text-style: bold; }
.stage-measuring { color: $accent; text-style: bold; }
.stage-success { color: $success; text-style: bold; }
.stage-error { color: $error; text-style: bold; }

#bottom-panel { dock: bottom; height: 5; background: $background; }
#slash-command-bar { height: 5; padding: 1 2; }
#slash-command { height: 3; border: round $panel; }
#slash-command:focus { border: round $accent; }
#bottom-panel.command-hidden { height: 0; }
#bottom-panel.command-hidden #slash-command-bar { display: none; }

/* Terminal cells, not pixels: stack fields when labels would squeeze inputs. */
AcprofTui.narrow .form-grid { grid-size: 2; grid-columns: 18 1fr; }
AcprofTui.narrow .checkbox-row { layout: vertical; }
AcprofTui.narrow .button-row { layout: grid; grid-size: 2; grid-gutter: 0 1; }
AcprofTui.narrow #status-grid { grid-columns: 11 1fr 9 1fr; }
AcprofTui.narrow Tab { padding: 0 1; }
/* Leave room for all seven English labels at 80 columns. */
AcprofTui.narrow #--content-tab-settings-tab { padding-left: 0; }
AcprofTui.short #bottom-panel { height: 3; }
AcprofTui.short #slash-command-bar { height: 3; padding: 0 2; }
AcprofTui.short #bottom-panel.command-hidden { height: 0; }
AcprofTui.short .section-title { margin: 0 0 1 0; }
AcprofTui.short .page-header { margin-bottom: 0; }
AcprofTui.short #report-detail { max-height: 3; margin-top: 0; }
AcprofTui.short #confirm-dialog { padding: 0 2; }
/* Keep the image detail groups visible alongside the fixed footer at 80x24. */
AcprofTui.narrow.short #image-heading { layout: horizontal; height: 1; }
AcprofTui.narrow.short #image-header .page-title { width: 8; margin-right: 1; }
AcprofTui.narrow.short #image-status { width: 1fr; max-height: 1; }
AcprofTui.narrow.short #image-storage {
    height: 1;
    min-height: 1;
    border: none;
    border-left: solid $foreground 60%;
    border-right: solid $foreground 60%;
}
AcprofTui.narrow.short #image-storage:hover, AcprofTui.narrow.short #image-storage:focus {
    border-left: solid $accent;
    border-right: solid $accent;
}
AcprofTui.narrow.short #image-detail { margin-bottom: 0; }
