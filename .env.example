# TUI: Settings (F2) -> Connections and permissions -> Connections.
# Or copy this file to .env.local and fill in your own values.
# Priority: exported environment > .env.local > .env.
HF_TOKEN=hf_xxx_your_token_here

# Do not set DOCKER_HOST here. AC-Prof requires the native Ubuntu daemon at
# unix:///var/run/docker.sock and rejects WSL, Docker Desktop, and remote daemons.

# Advanced Hub entry settings; ordinary TUI downloads always use auto.
HF_DOWNLOAD_MODE=auto
HF_ENDPOINT=https://hf-mirror.com
# HF_DOWNLOAD_MODE=official
# HF_DOWNLOAD_MODE=mirror-preferred
# HF_FALLBACK_ENDPOINTS=https://huggingface.co
# ACPROF_MAX_DOWNLOAD=5GB
# ACPROF_MODEL_STORE=/path/to/model-store
# ACPROF_MODEL_STORE_MAX=100GB
# AC-Prof does not configure VPNs/proxies. Export standard proxy variables in
# your shell/system instead; legacy proxy fields in project env files are ignored.
# See docs/CLI_Reference.md for a shell example. No egress/VPN inference is made.
# ACPROF_MODEL_SOURCE=modelscope
# MODELSCOPE_API_TOKEN=your_own_token
# TUI: Connections and permissions -> Profiling permissions -> Configure access.
# Review the plan, then authorize using the system sudo prompt; no password is saved.
# Administrator CLI alternative:
# docs/Getting_Started.md#最小权限安装

# Optional: Enterprise WeChat group-robot notifications. When configured,
# run.py enables WeCom by default (use --notify none to disable it). Keep the
# real Webhook in the ignored .env.local file; never commit or paste its key
# into logs or commands.
# ACPROF_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key
